# Puerto del backend (default 3001 si no se define)
PORT=3001

# URL del motor recetario-mcp (sin barra final). Ej: http://localhost:8012
MCP_BASE_URL=http://localhost:8012

# Si recetario-mcp tiene API_KEY, usar la misma clave aqui (se envia como X-API-Key al MCP)
# MCP_API_KEY=

# Si defines API_KEY, /api/mcp/* en este backend exige X-API-Key o Authorization: Bearer
# API_KEY=
