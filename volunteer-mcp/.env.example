# Brave Search API (opcional; sin clave las búsquedas pueden degradar o usar fallback)
BRAVE_API_KEY=

# Límites Brave (opcional)
BRAVE_MAX_RPS=0.8
BRAVE_MONTHLY_QUOTA=2000

# Redis (opcional; caché y blobs educativos)
REDIS_URL=

# Upstash REST (alternativa detectada en código de caché)
# UPSTASH_REDIS_REST_URL=

# PostgreSQL para jobs/educación (opcional; si no hay, SQLite local)
DATABASE_URL=

# Directorio de datos persistentes (Docker monta volumen en /app/data)
DATA_DIR=data
